{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": ["function", "data"]
      },
      "note": {
        "type": "string"
      },
      "path": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+$"
      },
      "status": {
        "type": "string",
        "enum": ["not-present", "unverified"]
      },
      "va": {
        "type": "string",
        "pattern": "^0x[0-9A-F]{8}$"
      }
    },
    "required": ["kind", "note", "path", "va"],
    "additionalProperties": false
  }
}
