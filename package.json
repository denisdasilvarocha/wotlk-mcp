{
  "name": "wotlk-mcp",
  "version": "0.0.0",
  "description": "Read-only MCP reference for World of Warcraft 3.3.5a build 12340.",
  "homepage": "https://github.com/denisdasilvarocha/wotlk-mcp#readme",
  "bugs": {
    "url": "https://github.com/denisdasilvarocha/wotlk-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisdasilvarocha/wotlk-mcp.git"
  },
  "bin": {
    "wotlk-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:reference": "vpx scripts/build-reference.ts",
    "check": "vp check",
    "dev": "vp pack --watch",
    "import:interface": "vpx scripts/import-interface.ts",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "test": "vp test",
    "validate:offsets": "vpx scripts/validate-offsets.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
