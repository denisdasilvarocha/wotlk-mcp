# Normalize text to LF in the repository; Git detects binaries.
* text=auto eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Collapse lockfiles in GitHub diffs and keep them out of language stats.
# No -diff: lockfile changes stay reviewable in `git diff`.
pnpm-lock.yaml linguist-generated
